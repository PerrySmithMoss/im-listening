// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = "js"
}

model Post {
  id             Int         @id @default(autoincrement())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  albumName      String      @db.VarChar(255)
  artistName     String      @db.VarChar(255)
  albumImage     String      @default("") @db.VarChar(255)
  rating         Decimal     @db.Decimal(10, 1)
  title          String
  previewSongUrl String?     @db.VarChar(255)
  genre          String      @db.VarChar(255)
  published      Boolean     @default(false)
  author         User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId       Int
  songGenres     SongGenre[]

  @@index([createdAt, id])
  @@index([authorId])
}

model SongGenre {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  genre     String   @db.VarChar(255)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int

  @@index([postId])
}

model Profile {
  id     Int     @id @default(autoincrement())
  bio    String?
  avatar String?
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int     @unique
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email     String   @unique @db.VarChar(191)
  password  String?
  sessionVersion Int @default(0)
  firstName String
  lastName  String
  username  String   @unique @db.VarChar(191)
  posts     Post[]
  profile   Profile?
  externalIdentities ExternalIdentity[]
}

model ExternalIdentity {
  issuer  String
  subject String
  userId  Int
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([issuer, subject])
  @@unique([userId, issuer])
}
