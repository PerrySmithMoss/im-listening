{
  "name": "im-listening-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.22.2 || ^26.13.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "tsc-watch --onSuccess \"node dist/src/index.js\"",
    "start": "node dist/src/index.js",
    "generate": "prisma generate",
    "build": "npm run generate && tsc -p .",
    "db:migrate": "prisma migrate deploy",
    "schema": "node dist/src/printSchema.js",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@graphile/depth-limit": "0.4.0",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "connect-redis": "10.0.0",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "express-session": "1.19.0",
    "graphql": "16.15.0",
    "graphql-scalars": "2.0.1",
    "helmet": "8.3.0",
    "nodemailer": "10.5.0",
    "rate-limit-redis": "6.0.2",
    "redis": "6.3.1",
    "reflect-metadata": "0.2.2",
    "type-graphql": "2.0.0-rc.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "^24",
    "@types/nodemailer": "8.0.2",
    "prisma": "7.10.1",
    "smtp-server": "3.21.4",
    "tsc-watch": "^7",
    "typescript": "6.0.3"
  },
  "overrides": {
    "type-graphql": {
      "graphql-scalars": "$graphql-scalars"
    }
  }
}
